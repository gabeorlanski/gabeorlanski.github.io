---
// Dev-only 16:9 cards of the LibraryDesignBench post's figures, captured as
// announcement images. Production builds get no pages from this route.
import "@/styles/global.css";
import LdbOverview from "@/components/figs/LdbOverview.astro";
import LdbConvergence from "@/components/figs/LdbConvergence.astro";
import LdbFailureTaxonomy from "@/components/figs/LdbFailureTaxonomy.astro";
import LdbGuidance from "@/components/figs/LdbGuidance.astro";
import LdbTask from "@/components/figs/LdbTask.astro";
import LdbLeaderboardCard from "@/components/figs/LdbLeaderboardCard.astro";
import { DESIGN_PANELS } from "@/components/figs/LdbPareto";
import { USE_PANELS } from "@/components/figs/LdbUsePareto";
import { ParetoChart } from "@/components/figs/ldb/ParetoChart";

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return [
    "leaderboard",
    "overview",
    "task",
    "pareto",
    "convergence",
    "failures",
    "use",
    "guidance",
  ].map(fig => ({ params: { fig } }));
}

const { fig } = Astro.params;

const CARDS: Record<string, { title: string; sub: string; width: number }> = {
  leaderboard: {
    title: "LibraryDesignBench leaderboard",
    sub: "",
    width: 620,
  },
  overview: {
    title: "Can agents design libraries for agents?",
    sub: "One agent designs a library. Other agents use it. Only their code is scored.",
    width: 1000,
  },
  task: {
    title: "What's in a task",
    sub: "Two phases: one agent designs a library, then other agents solve the task's problems with it.",
    width: 1000,
  },
  pareto: {
    title: "Opus 5.5 and Fable 5.1 beat the production library",
    sub: "Library score against what it cost to design (left) and what implementers spent per problem using it (right).",
    width: 1000,
  },
  convergence: {
    title: "Agents converge on the same designs",
    sub: "README quick-starts from three clirs libraries each. Both models copy clap's builder API.",
    width: 1000,
  },
  failures: {
    title: "Most excess code traces back to the library",
    sub: "Primary cause per designer. Test failures split more evenly between library and implementer.",
    width: 900,
  },
  use: {
    title: "Using a real library well scales with the model",
    sub: "LibraryUseBench: each model gets the real library and is told to write as little code as possible.",
    width: 820,
  },
  guidance: {
    title: "Designing explicitly for agents helps, modestly",
    sub: "GPT-6 Astra designing with and without an agent-first guidance prompt.",
    width: 900,
  },
};
const card = CARDS[fig!];

// Names printed beside points, placed by hand to avoid collisions.
// Names only on the frontier, plus Fable 5.1, the other designer above the production line.
const designPanels = DESIGN_PANELS.map((panel, i) => ({
  ...panel,
  title: ["Design cost", "Implementer cost"][i],
  labels: [
    {
      "opus-5-5-mini-swe": "right",
      "fable-5-1-mini-swe": "left",
      "gpt-6-astra-mini-swe": "left",
      "grok-4-6-mini-swe": "right",
      "gpt-5-6-sol-codex": "below-left",
      "gpt-6-sol-mini-swe": "below",
    },
    {
      "opus-5-5-mini-swe": "right",
      "fable-5-1-mini-swe": "left",
      "gpt-6-astra-mini-swe": "left",
      "gpt-6-sol-mini-swe": "left",
    },
  ][i],
})) as typeof DESIGN_PANELS;
const usePanels = [
  {
    ...USE_PANELS[0],
    labels: {
      "opus-5-5": "right",
      "sonnet-5-5": "left",
      "gpt-6-sol": "left",
      "opus-5": "left",
      "sonnet-5": "right",
      "deepseek-v4-1-flash": "left",
      "gpt-5-6-terra": "right",
      "glm-5-3-flash": "left",
      "deepseek-v4-flash": "right",
      "gpt-6-luna": "right",
      "gpt-5-6-luna": "right",
    },
  },
] as typeof USE_PANELS;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>{card.title}</title>
    {
      fig === "leaderboard" && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=block"
        />
      )
    }
  </head>
  <body>
    {
      fig === "leaderboard" && (
        <main class="share-board">
          <LdbLeaderboardCard />
        </main>
      )
    }
    <main class="share" data-fig={fig} hidden={fig === "leaderboard"}>
      <header>
        <h1>{card.title}</h1>
        <p class="share-sub">{card.sub}</p>
      </header>
      <div class="share-body">
        <div class="share-fit" style={`width: ${card.width}px`}>
          {fig === "overview" && <LdbOverview />}
          {fig === "task" && <LdbTask />}
          {
            fig === "pareto" && (
              <ParetoChart panels={designPanels} label={card.title}>
                <div class="share-legend">
                  <div class="ldb-legend">
                    <span class="ldb-legend-item">
                      <span
                        class="ldb-legend-line"
                        style="border-top: 2px dashed var(--ldb-pl)"
                      />
                      Production library
                    </span>
                    <span class="ldb-legend-item">
                      <span
                        class="ldb-legend-line"
                        style="border-top: 2px dashed var(--ldb-nl)"
                      />
                      No library
                    </span>
                    <span class="ldb-legend-item">
                      <span class="ldb-legend-line" />
                      Pareto frontier
                    </span>
                  </div>
                </div>
              </ParetoChart>
            )
          }
          {fig === "convergence" && <LdbConvergence />}
          {fig === "failures" && <LdbFailureTaxonomy />}
          {
            fig === "use" && (
              <ParetoChart panels={usePanels} label={card.title}>
                <div class="share-legend">
                  <div class="ldb-legend">
                    <span class="ldb-legend-item">
                      <span class="ldb-legend-line" />
                      Pareto frontier
                    </span>
                    <span class="ldb-legend-item">
                      <span class="ldb-legend-ci" />
                      95% interval
                    </span>
                  </div>
                </div>
              </ParetoChart>
            )
          }
          {
            fig === "guidance" && (
              <>
                <LdbGuidance />
                <div class="share-stats">
                  <div>
                    <span class="k">Score</span>
                    <span class="v">44.1 → 46.4</span>
                    <span class="n">production library: 46.6</span>
                  </div>
                  <div>
                    <span class="k">Where the gain comes from</span>
                    <span class="v">+2.5 / −0.9</span>
                    <span class="n">simplicity / correctness, points</span>
                  </div>
                  <div>
                    <span class="k">Cost to design a library</span>
                    <span class="v">$4.51 → $8.24</span>
                    <span class="n">cost per problem unchanged</span>
                  </div>
                </div>
              </>
            )
          }
        </div>
      </div>
    </main>

    <script is:inline>
      // Scale the figure to fill the space under the header.
      document.fonts.ready.then(() => {
        const body = document.querySelector(".share-body");
        const fit = document.querySelector(".share-fit");
        if (document.querySelector(".share-board")) {
          window.__shareReady = true;
          return;
        }
        const zoom = Math.min(
          body.clientWidth / fit.offsetWidth,
          body.clientHeight / fit.offsetHeight
        );
        fit.style.zoom = String(zoom);
        window.__shareReady = true;
      });
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        background: var(--background);
      }
      body {
        min-height: 0 !important;
      }
      /* The leaderboard card sizes to its content and is captured by its box. */
      .share-board {
        box-sizing: border-box;
        width: 620px;
        padding: 36px 32px 28px;
        color: var(--foreground);
        background: var(--background);
      }
      .share[hidden] {
        display: none;
      }
      .share {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        width: 1200px;
        height: 675px;
        padding: 30px 40px 24px;
        overflow: hidden;
        color: var(--foreground);
      }
      .share h1 {
        margin: 0;
        font-size: 34px;
        line-height: 1.15;
        font-weight: 700;
      }
      .share-sub {
        margin: 8px 0 0;
        font-size: 17px;
        line-height: 1.4;
        color: color-mix(in srgb, var(--foreground) 65%, transparent);
      }
      .share-body {
        flex: 1;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 14px 0 0;
      }

      /* Card-only overrides: no captions, notes or width caps. */
      .share figure {
        margin: 0 !important;
      }
      .share figcaption,
      .share details,
      .share .ldb-caption {
        display: none !important;
      }
      .share .cs-chart,
      .share .mc-chart,
      .share .ldb-grid-layout.single {
        max-width: none;
      }
      .share-legend {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 28px;
        margin-top: 4px;
        font-size: 15px;
      }

      /* Card-only type: charts are read at phone width, so their text runs larger than on the post. */
      .share .ldb-title {
        font-size: 17px;
      }
      .share .ldb-y-axis,
      .share .ldb-x-axis,
      .share .ldb-point-label,
      .share .ldb-ref-line > span {
        font-size: 14.5px;
      }
      .share .ldb-legend {
        font-size: 15px;
      }
      .share .cv-legend {
        font-size: 15px;
      }
      .share .cv-who {
        font-size: 17px;
      }
      .share .ldb-converge .cv-panel pre {
        font-size: 13px;
        padding: 12px 12px;
      }
      .share .ldb-task .tk-file-body,
      .share .ldb-task .tk-problem-files,
      .share .ldb-task .tk-step,
      .share .ldb-task .tk-score,
      .share .ldb-task .tk-phase-meta {
        font-size: 14.5px;
      }
      .share .ldb-task .tk-other,
      .share .ldb-task .tk-pill {
        font-size: 13.5px;
      }
      .share .ldb-task .tk-phase-name,
      .share .ldb-task .tk-title {
        font-size: 19px;
      }
      /* Every point is named on the cards, so points off the frontier stay legible. */
      .share .ldb-point.off {
        opacity: 0.8;
      }
      /* Smaller marks leave the crowded middle of the Pareto panels readable. */
      .share[data-fig="pareto"] .ldb-point .ldb-badge {
        width: 19px;
        height: 19px;
        border-radius: 5px;
      }
      .share[data-fig="pareto"] .ldb-point .ldb-badge svg {
        width: 11px;
        height: 11px;
      }
      .share[data-fig="pareto"] .ldb-point .ldb-badge.ref {
        font-size: 9px;
      }
      /* A wider halo, so the frontier line does not run through a name. */
      .share[data-fig="pareto"] .ldb-point-label {
        text-shadow:
          0 0 2px var(--background),
          0 0 3px var(--background),
          0 0 4px var(--background),
          0 0 5px var(--background),
          0 0 6px var(--background);
      }
      .share-legend .ldb-legend {
        margin-top: 6px;
      }
      .share-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 22px;
      }
      .share-stats > div {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 14px 18px;
        border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
        border-radius: 10px;
      }
      .share-stats .k {
        font-size: 15px;
        color: color-mix(in srgb, var(--foreground) 62%, transparent);
      }
      .share-stats .v {
        font-size: 28px;
        font-weight: 700;
      }
      .share-stats .n {
        font-size: 14px;
        color: color-mix(in srgb, var(--foreground) 62%, transparent);
      }
    </style>
  </body>
</html>
