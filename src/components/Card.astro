---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import PaperInfo from "./PaperInfo.astro";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id, filePath } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, codeLink, arxivLink, isPaper, paperType, authors } = data;

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: `${isPaper ? "text-base" : "text-lg"} font-medium decoration-dashed hover:underline`,
};

// Use arxivLink if no blog file exists (filePath is undefined) and arxivLink is present
const linkHref = !filePath && arxivLink ? arxivLink : getPath(id, filePath);
---

<li class:list={[isPaper ? "my-5" : "my-6"]}>
  <a
    href={linkHref}
    class:list={[
      "inline-block font-medium text-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0",
      isPaper ? "text-base" : "text-lg",
    ]}
  >
    {
      variant === "h2" ? (
        <h2 {...headerProps}>{title}</h2>
      ) : (
        <h3 {...headerProps}>{title}</h3>
      )
    }
  </a>
  {
    isPaper ? (
      <PaperInfo {pubDatetime} {codeLink} {arxivLink} {isPaper} {paperType} {authors}/>
    ) : (
      <div class="flex items-center gap-2">
        <Datetime {pubDatetime} {modDatetime} {timezone} />
        {codeLink && (
          <a
            href={codeLink}
            class="inline-flex items-center gap-1 opacity-80 hover:opacity-100"
            aria-label="View code on GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconGitHub class="size-5" />
            <span>[code]</span>
          </a>
        )}
      </div>
    )
  }
  {description && <p>{description}</p>}
</li>
