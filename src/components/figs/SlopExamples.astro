---
// Several code examples for one paragraph, one at a time: each example's <h4> title becomes a tab. Children are generated
// example components (each a .slop-example). Without JS every example shows.
---

<section class="slop-examples" data-slop-examples>
  <nav class="not-prose" aria-label="Examples"></nav>
  <slot />
</section>

<script>
  function setUp(root: HTMLElement) {
    const nav = root.querySelector("nav")!;
    const panels = [...root.querySelectorAll<HTMLElement>(".slop-example")];
    const buttons = panels.map(panel => {
      // The title without the heading's anchor link.
      const title = panel.querySelector("h4")!.cloneNode(true) as HTMLElement;
      title.querySelectorAll("a").forEach(a => a.remove());
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = title.textContent!.trim();
      button.addEventListener("click", () => show(panel));
      nav.append(button);
      return button;
    });
    const show = (active: HTMLElement) =>
      panels.forEach((panel, i) => {
        panel.hidden = panel !== active;
        buttons[i].setAttribute("aria-pressed", String(panel === active));
      });
    root.classList.add("ready");
    show(panels[0]);
  }
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-slop-examples]:not(.ready)")
      .forEach(setUp);
  });
</script>

<style>
  /* Editor tabs: a flat strip joined to the panel below; the open tab takes the panel's background and an accent line
     on top, the rest stay muted. Long titles wrap the strip onto more rows instead of scrolling. */
  .slop-examples {
    --tab-line: color-mix(in srgb, var(--foreground) 14%, transparent);
    --tab-strip: color-mix(in srgb, var(--foreground) 5%, var(--background));
    margin: 1.75rem 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    background: var(--tab-strip);
    border: 1px solid var(--tab-line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
    overflow: hidden;
  }
  /* Carries the strip's bottom edge past the last tab. */
  nav::after {
    content: "";
    flex: 1 0 0;
    margin-bottom: -1px;
    border-bottom: 1px solid var(--tab-line);
  }
  nav :global(button) {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    margin-bottom: -1px;
    padding: 7px 14px 6px;
    font-size: 13px;
    text-align: left;
    color: color-mix(in srgb, var(--foreground) 60%, transparent);
    background: none;
    border: 0;
    border-top: 2px solid transparent;
    border-right: 1px solid var(--tab-line);
    border-bottom: 1px solid var(--tab-line);
    cursor: pointer;
  }
  nav :global(button:hover) {
    color: var(--foreground);
  }
  nav :global(button[aria-pressed="true"]) {
    color: var(--foreground);
    background: var(--background);
    border-top-color: var(--accent);
    border-bottom-color: var(--background);
  }
  /* The panel the tabs belong to. Before the script runs there are no tabs, so the examples show unframed. */
  .slop-examples.ready {
    border-bottom: 1px solid var(--tab-line);
  }
  .slop-examples.ready :global(.slop-example) {
    margin: 0;
    padding: 12px;
    border: 1px solid var(--tab-line);
    border-top: 0;
    border-bottom: 0;
  }
  /* The selected tab already names the example. */
  .slop-examples.ready :global(.slop-example > h4) {
    display: none;
  }
</style>
